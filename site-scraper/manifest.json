{
  "manifest_version": 3,
  "name": "Site Scraper",
  "version": "1.1.1",
  "description": "Grab all the content from a page, or crawl a whole site, and export it as Markdown, text, JSON or CSV.",
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Site Scraper",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
